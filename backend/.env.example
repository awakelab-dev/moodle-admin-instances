# Server
PORT=5001

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/moodle_admin?schema=public"

# Auth
AUTH_TOKEN_SECRET=change-this-secret

# SCORM (bucket S3 para el visualizador — ver bucket policy / IAM policy
# en la documentacion del proyecto). Las credenciales AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY las coge automaticamente el SDK de este .env.
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
