generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
}

enum AuthRole {
  admin
  limited
}

enum SyncStatus {
  running
  completed
  failed
}

model Platform {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  url           String
  token         String
  monthlyCharge Decimal? @map("monthly_charge") @db.Decimal(12, 2)
  currency      Currency @default(USD)
  isActive      Boolean   @default(true) @map("is_active")
  lastSyncedAt  DateTime? @map("last_synced_at")
  // Sincronizacion dedicada de "Cursos y Alumnos" (matricula, accesos,
  // actividades, notas por item, mensajes de foro) — separada de
  // lastSyncedAt, que es la del storage/tamano de curso.
  coursesLastSyncedAt DateTime? @map("courses_last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Credencial dedicada para que el plugin local_courseprogressnotify (que
  // corre DENTRO de esta plataforma) llame de vuelta a nuestra API —
  // direccion inversa al `token` de arriba (que es para que NOSOTROS
  // llamemos al Web Service de Moodle). Null hasta que se genera desde
  // Configuracion; se guarda ya hasheada, igual que una contrasena.
  notificationsApiKeyHash String? @map("notifications_api_key_hash")

  courses     Course[]
  users       MoodleUser[]
  snapshots   PlatformSnapshot[]
  enrollments CourseEnrollment[]
  userAccess  UserPlatformAccess[]
  notificationRules NotificationRule[]
  notificationDeliveryLogs NotificationDeliveryLog[]

  @@map("platforms")
}

enum NotificationTrigger {
  progress_25
  progress_50
  progress_75
  course_end_soon
  course_last_day
  zoom_session
  presential_exam
  presential_tutoring
  diploma_available
  first_day
  second_day

  @@map("notification_trigger")
}

// Plantilla de email (asunto + cuerpo con placeholders {{var}}), por
// idioma. Una NotificationRule la asocia a un disparador concreto.
model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String
  language  String   @default("es") // es | ca | en
  subject   String
  bodyHtml  String   @map("body_html")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rules NotificationRule[]

  @@map("notification_templates")
}

// Asocia un disparador con la plantilla que debe usar. platformId null =
// regla global (aplica a toda plataforma que no tenga una regla mas
// especifica para ese mismo trigger). La unicidad real (a lo sumo una
// regla especifica por trigger+plataforma, a lo sumo una global por
// trigger) se aplica con DOS indices unicos parciales en la migracion
// (ver migration.sql), no con un @@unique de Prisma: Postgres trata cada
// NULL como distinto de si mismo en una unique constraint normal, asi que
// un @@unique([trigger, platformId]) NO evitaria dos reglas globales
// duplicadas para el mismo trigger (platformId siempre NULL ahi).
model NotificationRule {
  id         String              @id @default(uuid())
  trigger    NotificationTrigger
  platformId String?             @map("platform_id")
  platform   Platform?           @relation(fields: [platformId], references: [id], onDelete: Cascade)
  templateId String              @map("template_id")
  template   NotificationTemplate @relation(fields: [templateId], references: [id])
  isActive   Boolean             @default(true) @map("is_active")
  // Parametros propios del trigger (umbral de progreso, dias de
  // antelacion, palabras clave de deteccion presencial, etc.) — cada
  // trigger define su propia forma esperada, validada en el servicio, no
  // en el schema.
  params     Json                @default("{}")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@index([trigger, platformId])
  @@map("notification_rules")
}

// Reemplaza/centraliza el log que hoy vive aislado en cada Moodle
// (local_courseprogressnotify_log): un registro por cada intento de envio
// que el plugin reporta despues de intentarlo. courseId/userId son ids de
// Moodle (no unicos entre plataformas), por eso el indice unico de
// deduplicacion siempre incluye platformId.
model NotificationDeliveryLog {
  id           String              @id @default(uuid())
  platformId   String              @map("platform_id")
  platform     Platform            @relation(fields: [platformId], references: [id], onDelete: Cascade)
  trigger      NotificationTrigger
  courseId     Int                 @map("course_id")
  userId       Int                 @map("user_id")
  // Id de la entidad asociada cuando aplica (evento de calendario para
  // presencial, sesion de Zoom, etc.) — '' (NO null) para triggers sin
  // entidad propia (progreso, fin de curso, diploma, primer/segundo dia):
  // el @@unique de abajo lo incluye, y NULL no es igual a si mismo en una
  // unique constraint normal de Postgres, asi que null habria permitido
  // duplicados exactos ahi (mismo fallo que se evito en NotificationRule,
  // pero aqui con string vacio en vez de indices parciales porque no hay
  // semantica global/especifico que resolver, solo "sin entidad").
  entityId     String              @default("") @map("entity_id")
  success      Boolean
  errorMessage String?             @map("error_message")
  sentAt       DateTime            @default(now()) @map("sent_at")

  @@unique([platformId, trigger, courseId, userId, entityId])
  @@map("notification_delivery_log")
}

model Course {
  id         String   @id @default(uuid())
  platformId String   @map("platform_id")
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  moodleName   String @map("moodle_name")
  courseId     Int    @map("course_id")
  courseName   String @map("course_name")
  shortname    String @default("")
  categoryId   Int    @map("category_id")
  categoryName String @default("Sin categoría") @map("category_name")
  visible      Boolean @default(true)
  averageGradePercent Float? @map("average_grade_percent")
  startDate Int? @map("start_date")
  endDate   Int? @map("end_date")

  sizeBytes           BigInt @default(0) @map("size_bytes")
  backupSizeBytes     BigInt @default(0) @map("backup_size_bytes")
  assignmentSizeBytes BigInt @default(0) @map("assignment_size_bytes")
  forumSizeBytes      BigInt @default(0) @map("forum_size_bytes")

  detailedSizeBytes           BigInt    @default(0) @map("detailed_size_bytes")
  detailedBackupSizeBytes     BigInt    @default(0) @map("detailed_backup_size_bytes")
  detailedAssignmentSizeBytes BigInt    @default(0) @map("detailed_assignment_size_bytes")
  detailedForumSizeBytes      BigInt    @default(0) @map("detailed_forum_size_bytes")
  detailedTotalBytes          BigInt    @default(0) @map("detailed_total_bytes")
  detailedCalculatedAt        DateTime? @map("detailed_calculated_at")

  storageBreakdown         Json @default("[]") @map("storage_breakdown")
  detailedStorageBreakdown Json @default("[]") @map("detailed_storage_breakdown")

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platformId, courseId], name: "platform_course_unique")
  @@index([categoryId])
  @@map("courses")
}

model MoodleUser {
  id         String   @id @default(uuid())
  platformId String   @map("platform_id")
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  moodleName     String @map("moodle_name")
  userId         Int    @map("user_id")
  username       String
  fullname       String @default("")
  email          String @default("")
  totalSizeBytes BigInt @default(0) @map("total_size_bytes")
  averageGradePercent Float? @map("average_grade_percent")

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platformId, userId], name: "platform_user_unique")
  @@map("moodle_users")
}

model CourseEnrollment {
  id         String   @id @default(uuid())
  platformId String   @map("platform_id")
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  courseId Int @map("course_id")
  userId   Int @map("user_id")

  // Snapshot de "Lista de alumnos"/"Informe global"/"Calificaciones" — se
  // llena en la sincronizacion dedicada de Cursos y Alumnos (separada del
  // sync de storage) y se lee sin tocar Moodle en el momento. Todo nullable
  // porque una plataforma sin permisos de calificaciones/finalizacion no
  // tendra esos campos. firstname/lastname/username/email se duplican aqui
  // (en vez de unir con MoodleUser) para no depender del sync de storage.
  firstname String @default("")
  lastname  String @default("")
  username  String @default("")
  email     String @default("")
  roles             String[] @default([])
  activeEnrollment  Boolean?          @map("active_enrollment")
  firstAccess       Int?              @map("first_access")
  lastAccess        Int?              @map("last_access")
  lastCourseAccess  Int?              @map("last_course_access")
  activitiesCompleted Int?            @map("activities_completed")
  activitiesTotal     Int?            @map("activities_total")
  finalGrade          String?         @map("final_grade")
  evaluationsCompleted Int?           @map("evaluations_completed")
  evaluationsTotal      Int?          @map("evaluations_total")
  forumMessageCount     Int?          @map("forum_message_count")
  coursePercentage      String?       @map("course_percentage")
  courseScoreOutOf10    String?       @map("course_score_out_of_10")
  gradeItems            Json?         @map("grade_items")

  syncedAt DateTime @default(now()) @map("synced_at")

  @@unique([platformId, courseId, userId], name: "platform_course_user_unique")
  @@index([platformId, courseId])
  @@index([platformId, userId])
  @@map("course_enrollments")
}

model PlatformSnapshot {
  id         String   @id @default(uuid())
  platformId String   @map("platform_id")
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  moodleName    String   @map("moodle_name")
  month         String
  totalBytes    BigInt   @default(0) @map("total_bytes")
  monthlyCharge Decimal? @map("monthly_charge") @db.Decimal(12, 2)
  costPerGb     Decimal? @map("cost_per_gb") @db.Decimal(12, 4)
  currency      Currency @default(USD)
  income        Decimal? @db.Decimal(12, 2)
  cost          Decimal? @db.Decimal(12, 2)
  margin        Decimal? @db.Decimal(12, 2)

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platformId, month], name: "platform_month_unique")
  @@map("platform_snapshots")
}

model SyncLog {
  id              String     @id @default(uuid())
  startedAt       DateTime   @default(now()) @map("started_at")
  completedAt     DateTime?  @map("completed_at")
  status          SyncStatus @default(running)
  platformsTotal  Int        @default(0) @map("platforms_total")
  platformsSynced Int        @default(0) @map("platforms_synced")
  currentPlatform String     @default("") @map("current_platform")
  syncErrors      String[]   @default([]) @map("sync_errors")

  @@map("sync_logs")
}

model AuthUser {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String   @map("display_name")
  role         AuthRole @default(limited)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  platformAccess UserPlatformAccess[]

  @@map("auth_users")
}

// Qué plataformas puede ver un usuario "limited" (rol "usuario", no
// superadmin) en Moodle Insights (Dashboard/Cursos y Alumnos). Los admin
// ven todas las plataformas siempre, sin pasar por esta tabla — solo se
// consulta para filtrar cuando el usuario actual es "limited".
model UserPlatformAccess {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  platformId String   @map("platform_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([userId, platformId])
  @@map("user_platform_access")
}
